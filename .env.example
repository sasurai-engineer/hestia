# Hestia configuration.
#
# Copy to `.env` (never commit it) and fill in. Every variable the code reads
# must appear here; `scripts/config_audit.py` fails the build otherwise.

# ---------------------------------------------------------------------------
# Datastore
# ---------------------------------------------------------------------------
HESTIA_DATABASE_URL=postgresql://hestia:hestia@localhost:5432/hestia
# Test-only: when set, the API test suite uses this server instead of
# spinning up a disposable container. CI sets it to its service database.
HESTIA_TEST_DATABASE_URL=
# The browser origin allowed to call the API (the Next.js dev server).
HESTIA_WEB_ORIGIN=http://localhost:3000
# Where the web app finds the API (browser-side; baked in at next build).
NEXT_PUBLIC_HESTIA_API_URL=http://localhost:8000
# Where the e2e suite finds the web app (defaults to the dev server).
HESTIA_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI runtime (Clio — OpenAI-compatible). Capability roles resolve to providers.
# ---------------------------------------------------------------------------
HESTIA_RUNTIME_BASE_URL=http://localhost:8080
HESTIA_RUNTIME_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Property data providers. Free core; paid enrichment is optional and adapters
# are provider-agnostic, so a richer source can be swapped in without touching
# the domain model.
# ---------------------------------------------------------------------------
HESTIA_RENTCAST_API_KEY=
HESTIA_RENTCAST_ENABLED=false
HESTIA_CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov
HESTIA_FEMA_NFHL_URL=https://hazards.fema.gov
HESTIA_FRED_API_KEY=
