# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# test & coverage
coverage/
.nyc_output/
reports/
stryker.log
.stryker-tmp/
test-results/
playwright-report/
blob-report/
.lighthouseci/
# The two patterns above are tool-output names that also happen to be app
# routes. Without these negations, git silently swallows the route source —
# /reports and /coverage 404'd on every fresh checkout while passing locally.
!apps/web/src/app/coverage/
!apps/web/src/app/reports/

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# rust / tauri
target/

# env & secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key

# supply chain artifacts
sbom*.json
*.sig
*.intoto.jsonl

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
